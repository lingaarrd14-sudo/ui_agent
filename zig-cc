#!/usr/bin/env bash
# Triton requests -l:libcuda.so.1; pass WSL's driver library explicitly.
args=()
for arg in "$@"; do
  if [[ "$arg" == "-l:libcuda.so.1" && -f /usr/lib/wsl/lib/libcuda.so.1 ]]; then
    args+=(/usr/lib/wsl/lib/libcuda.so.1)
  else
    args+=("$arg")
  fi
done
exec /home/default/agent/webarena/.venv/lib/python3.11/site-packages/ziglang/zig cc "${args[@]}"
